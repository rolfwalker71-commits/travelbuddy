# TravelBuddy – Umgebungsvariablen (nur Namen und Beispielwerte, keine Geheimnisse).
# Kopieren nach .env (git-ignoriert) und Werte eintragen. Nie echte Schlüssel in diese Datei schreiben.

# ── Server ────────────────────────────────────────────────────────────────────
# Standardport für `npm run dev` / `npm start` ist 7780; im Container ebenfalls 7780 (PORT).
# TRAVELBUDDY_PORT weiter unten ist nur der Host-Port der Docker-Compose-Veröffentlichung.
PORT=7780
HOST=127.0.0.1
TRAVELBUDDY_DB_PATH=./data/travelbuddy.sqlite
# Datenordner (documents/, media/, apns/); Standard: Ordner der Datenbank
TRAVELBUDDY_DATA_DIR=
# Einzelne Ordner abweichend vom Datenordner (Standard: <Datenordner>/documents bzw. /media)
TRAVELBUDDY_DOCUMENTS_DIR=
TRAVELBUDDY_MEDIA_DIR=
TRAVELBUDDY_TZ=Europe/Zurich
# Ordner mit dem gebauten Web-Client (index.html); Standard: ./web oder ../web/dist
TRAVELBUDDY_WEB_DIR=
# Zugriffsprotokoll: 0 schaltet ab
TRAVELBUDDY_ACCESS_LOG=1
# Minuten zwischen Hintergrundläufen (Dokumentanalyse, Bilder); 0 = aus
TRAVELBUDDY_MAINTENANCE_MINUTES=5
# Sekunden zwischen Läufen des Mitteilungs-Schedulers (Erinnerungen, Live Activities); 0 = aus
TRAVELBUDDY_NOTIFY_SECONDS=60
# Ordner shared/illustrations (Mitteilungsbilder unter notifications/); Standard: Repo-Pfad, im Container /app/shared/illustrations
TRAVELBUDDY_ILLUSTRATIONS_DIR=
# Pfad zu shared/event-types.json, falls abweichend vom Standard
TRAVELBUDDY_CATALOG_PATH=
# Flughafentabelle (JSON), falls abweichend von src/meta/airports.json bzw. dist/data/airports.json
TRAVELBUDDY_AIRPORTS_PATH=
# Mitteilungsbilder (PNG hell/dunkel); Standard: shared/illustrations (im Container /app/shared/illustrations)
TRAVELBUDDY_ILLUSTRATIONS_DIR=
# Mitteilungen/Live Activities: Sekunden zwischen den Läufen des Planers; 0 = aus
TRAVELBUDDY_NOTIFY_SECONDS=60
# Import aus HomeBuddy beim Start, wenn die Datenbank keine Reise enthält: Pfad zur homebuddy.sqlite
# (Dokumente aus <Ordner>/documents). Im Dev-Modus (npm run dev) gilt ../import-in/homebuddy.sqlite; off schaltet ab.
TRAVELBUDDY_BOOTSTRAP_IMPORT=
# 1 = verhält sich wie `npm run dev` (Bootstrap-Import aus ../import-in), auch ohne npm
TRAVELBUDDY_DEV=
# Angaben für GET /v1/version (setzt der Docker-Build); Pfad der VERSION-Datei bei Sonderfällen
TRAVELBUDDY_BUILD=
TRAVELBUDDY_BUILT_AT=
TRAVELBUDDY_VERSION_FILE=
# Passwort für `npm run user:create` / `user:password` ohne Rückfrage (mindestens 12 Zeichen); nie dauerhaft setzen
TRAVELBUDDY_PASSWORD=

# ── KI (optional): Dokumentanalyse und Bilder ────────────────────────────────
# Ohne Schlüssel läuft die Analyse nur mit Barcode (BCBP), .ics und .pkpass; PDFs bleiben «übersprungen».
OPENAI_API_KEY=
# OpenAI-kompatibler Endpunkt; Standard https://api.openai.com/v1
OPENAI_BASE_URL=
# Textmodell (PDF-Text, ICS, Pass) und Vision-Modell (Scans, Fotos)
TRAVELBUDDY_AI_MODEL_TEXT=gpt-4o-mini
TRAVELBUDDY_AI_MODEL_VISION=gpt-4o
# Neue Ereignisse werden ab dieser Sicherheit (0..1) und bei bestandenen Prüfungen automatisch bestätigt;
# ein Wert über 1 schaltet die Automatik ab (alles bleibt Vorschlag)
TRAVELBUDDY_AUTO_CONFIRM_MIN=0.92
# Toleranz (Tage) um den Reisezeitraum; Daten ausserhalb werden «zu prüfen»
TRAVELBUDDY_TRIP_TOLERANCE_DAYS=7
# Höchstzahl Zeichen je KI-Aufruf; längere Dokumente werden seitenweise geteilt
TRAVELBUDDY_AI_CHUNK_CHARS=24000
# KI-Bilder (Reise- und Ereignisbilder): aktiv mit OPENAI_API_KEY; 0 schaltet ab
TRAVELBUDDY_AI_IMAGES=
TRAVELBUDDY_AI_IMAGES_PER_RUN=5
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_IMAGE_BASE_URL=
# Eigener Schlüssel für Bilder (sonst OPENAI_API_KEY)
OPENAI_IMAGE_API_KEY=

# ── Push (APNs); alternativ genügt AuthKey_<KEYID>.p8 im Ordner <Datenordner>/apns ──
APNS_KEY=
APNS_KEY_PATH=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_TOPIC=
TRAVELBUDDY_APNS_DIR=

# ── Apple Karten (MapKit JS) und Geokodierung ─────────────────────────────────
TRAVELBUDDY_MAPKIT_TEAM_ID=
TRAVELBUDDY_MAPKIT_KEY_ID=
# Inhalt der .p8, einzeilig, Zeilenumbrüche als \n  –  oder Pfad zur Datei:
TRAVELBUDDY_MAPKIT_KEY=
TRAVELBUDDY_MAPKIT_KEY_PATH=
# Ursprung der Web-App, z. B. https://travel.example.ch (ohne Pfad)
TRAVELBUDDY_MAPKIT_ORIGIN=
# auto (Apple mit Schlüssel, sonst Nominatim) | apple | nominatim | off
TRAVELBUDDY_GEOCODER=auto
# Kontakt für den Nominatim-User-Agent (Nutzungsbedingungen), z. B. eine Mailadresse
TRAVELBUDDY_GEOCODER_CONTACT=
TRAVELBUDDY_NOMINATIM_URL=

# ── Docker-Compose ────────────────────────────────────────────────────────────
# Host-Adresse und Host-Port der Veröffentlichung (im Container bleibt PORT=7780)
TRAVELBUDDY_BIND=127.0.0.1
TRAVELBUDDY_PORT=7780
